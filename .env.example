# Copy to .env (repo root or backend/.env) and fill in real values. Never commit secrets.

# Application
APP_ENV=development          # development | production
APP_NAME=Farmer Assistance Platform
APP_VERSION=1.0.0
SECRET_KEY=
DATABASE_URL=

# Auth
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# CORS (comma-separated). Include your frontend origin(s).
CORS_ORIGINS=

# Weather (optional; labelled demo forecast used when empty)
OPENWEATHER_API_KEY=

# Market prices (optional; demo fixtures used when empty)
AGMARKNET_API_KEY=
AGMARKNET_RESOURCE_ID=

# SMS / OTP (required for real OTP delivery in production)
SMS_PROVIDER=dev             # dev | msg91 | fast2sms | twilio
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=             # required for MSG91
SMS_ACCOUNT_SID=             # required for Twilio
SMS_AUTH_TOKEN=              # required for Twilio
SMS_FROM_NUMBER=             # required for Twilio

# OTP policy
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5
OTP_MAX_PER_IP_HOUR=20

# Disease detection
DISEASE_CONFIDENCE_THRESHOLD=0.55

# Storage (uploaded images)
STORAGE_DIR=

# Data
ALLOW_MOCK_DATA=false         # must be false in production

# Frontend (Vite) - set in Vercel project settings
# VITE_API_BASE=https://your-backend.example.com/api/v1
